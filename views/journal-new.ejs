<%- include('partials/head') %>
<%- include('partials/nav') %>
<main class="container">
  <div class="panel">
    <h2>New journal entry</h2>
    <% if (error) { %><div class='error'><%= error %></div><% } %>
    <form method="POST" action="/journal/new">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="inline">
        <label style="flex:1">Entry number
          <input type="text" name="entryNumber" value="J-<%= Date.now() %>">
        </label>
        <label style="flex:1">Entry type
          <select name="entryType">
            <option value="Sales">Sales</option>
            <option value="Purchase">Purchase</option>
            <option value="Expense">Expense</option>
            <option value="COGS">COGS</option>
            <option value="Receipt">Receipt</option>
            <option value="Payment">Payment</option>
            <option value="Depreciation">Depreciation</option>
            <option value="Closing">Closing</option>
            <option value="Adjustment">Adjustment</option>
            <option value="Other">Other</option>
          </select>
        </label>
        <label style="flex:1">Date
          <input type="date" name="entryDate" value="<%= new Date().toISOString().slice(0,10) %>">
        </label>
      </div>
      <table>
        <thead>
          <tr><th>Account</th><th>Debit</th><th>Credit</th><th>Description</th></tr>
        </thead>
        <tbody>
          <% for (let i = 0; i < 4; i++) { %>
            <tr>
              <td>
                <select name="accountId[]">
                  <option value="">Select account</option>
                  <% accounts.forEach(function(a) { %>
                    <option value="<%= a.id %>"><%= a.code %> - <%= a.english_name %></option>
                  <% }); %>
                </select>
              </td>
              <td><input type="number" step="0.01" name="debit[]" value="0"></td>
              <td><input type="number" step="0.01" name="credit[]" value="0"></td>
              <td><input type="text" name="description[]"></td>
            </tr>
          <% } %>
        </tbody>
      </table>
      <label>Notes
        <textarea name="notes"></textarea>
      </label>
      <button type="submit">Post journal</button>
    </form>
  </div>
</main>
</body>
</html>
