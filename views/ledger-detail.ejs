<%- include('partials/head') %>
<%- include('partials/nav') %>
<main class="container">
  <div class="panel">
    <h2>Ledger detail: <%= account.english_name %> (<%= account.code %>)</h2>
    <table>
      <thead>
        <tr><th>Date</th><th>Entry</th><th>Type</th><th>Desc</th><th>Debit</th><th>Credit</th><th>Running</th></tr>
      </thead>
      <tbody>
        <% ledgerLines.forEach(function(line) { %>
          <tr>
            <td><%= line.entry_date %></td>
            <td><%= line.entry_number %></td>
            <td><%= line.entry_type %></td>
            <td><%= line.description %></td>
            <td><%= formatMoney(line.debit) %></td>
            <td><%= formatMoney(line.credit) %></td>
            <td><%= formatMoney(line.running_balance) %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</main>
</body>
</html>
